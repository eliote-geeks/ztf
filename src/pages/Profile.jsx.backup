                    <FaBookmark className="stat-icon-main" />
                    <div className="stat-main-content">
                      <span className="stat-main-number">{reservations.length}</span>
                      <span className="stat-main-label">Réservations actives</span>
                    </div>
                  </div>
                </div>
                
                <div className="stats-secondary">
                  <div className="stat-mini">
                    <FaClock className="stat-mini-icon warning" />
                    <div className="stat-mini-info">
                      <span className="stat-mini-number">{reservations.filter(r => r.position <= 3).length}</span>
                      <span className="stat-mini-label">Bientôt prêt</span>
                    </div>
                  </div>
                  <div className="stat-mini">
                    <FaListOl className="stat-mini-icon info" />
                    <div className="stat-mini-info">
                      <span className="stat-mini-number">{Math.round(reservations.reduce((acc, r) => acc + r.position, 0) / reservations.length) || 0}</span>
                      <span className="stat-mini-label">Position moy.</span>
                    </div>
                  </div>
                </div>
              </div>

              <div className="section-header-simple">
                <h4>Mes Réservations</h4>
                <div className="section-actions-simple">
                  <button className="btn-flat-primary">Nouvelle réservation</button>
                  <button className="btn-flat-outline">Historique</button>
                </div>
              </div>

              {/* Liste des réservations flat */}
              <div className="items-list-flat">
                {reservations.map((reservation, index) => (
                  <div key={reservation.id} className="item-row-flat">
                    <div className="item-position-flat">
                      <span className="position-badge-flat">#{reservation.position}</span>
                    </div>
                    
                    <div className="item-content-flat">
                      <div className="item-header-flat">
                        <h5 className="item-title-flat">{reservation.title}</h5>
                        <span className="status-badge-flat info">
                          {new Date(reservation.estimatedAvailability).toLocaleDateString('fr-FR')}
                        </span>
                      </div>
                      
                      <p className="item-author-flat">par {reservation.author}</p>
                      
                      <div className="item-details-flat">
                        <span className="detail-flat">Position #{reservation.position}</span>
                        <span className="detail-flat">≈ {reservation.position * 2} semaines</span>
                        <span className="detail-flat">Réservé le {new Date(reservation.reservationDate).toLocaleDateString('fr-FR')}</span>
                      </div>
                    </div>
                    
                    <div className="item-actions-flat">
                      <button className="btn-flat-outline">Détails</button>
                      <div className="dropdown-container">
                        <button 
                          className="btn-flat-outline dropdown-toggle"
                          onClick={() => setShowReservationDropdown({...showReservationDropdown, [reservation.id]: !showReservationDropdown[reservation.id]})}
                        >
                          <FaEllipsisV />
                          Actions
                        </button>
                        {showReservationDropdown[reservation.id] && (
                          <div className="dropdown-menu">
                            <button className="dropdown-item">
                              <FaBell />
                              Notifications
                            </button>
                            <button className="dropdown-item text-danger">
                              <FaTimes />
                              Annuler réservation
                            </button>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              {reservations.length === 0 && (
                <div className="empty-state">
                  <div className="empty-icon">
                    <FaBookmark />
                  </div>
                  <h3>Aucune réservation</h3>
                  <p>Vous n'avez aucune réservation en cours. Parcourez le catalogue pour réserver vos livres préférés.</p>
                  <button className="btn btn-primary">
                    <FaSearch />
                    Parcourir le catalogue
                  </button>
                </div>
              )}
            </div>
          )}

          {/* Section Recherche */}
          {activeTab === 'search' && (
            <div className="section-flat-content">
              {/* Barre de recherche principale */}
              <div className="search-section-main">
                <h2 className="search-title">Rechercher dans la bibliothèque</h2>
                <div className="search-container-main">
                  <div className="search-input-container">
                    <FaSearch className="search-icon-main" />
                    <input
                      type="text"
                      className="search-input-main"
                      placeholder="Rechercher par titre, auteur, ISBN..."
                      value={searchQuery}
                      onChange={(e) => handleSearchChange(e.target.value)}
                      onKeyPress={(e) => e.key === 'Enter' && handleSearchSubmit()}
                    />
                    <button className="search-btn-main" onClick={handleSearchSubmit}>
                      Rechercher
                    </button>
                  </div>
                  
                  {/* Suggestions de recherche */}
                  {showSuggestions && searchSuggestions.length > 0 && (
                    <div className="search-suggestions">
                      {searchSuggestions.map(suggestion => (
                        <div key={suggestion.id} className="suggestion-item" onClick={() => setSearchQuery(suggestion.title)}>
                          <div className="suggestion-content">
                            <div className="suggestion-title">{suggestion.title}</div>
                            <div className="suggestion-author">par {suggestion.author}</div>
                          </div>
                          <div className="suggestion-type">
                            {suggestion.type === 'ebook' ? <FaFileAlt /> : <FaBook />}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              {/* Catégories de recherche */}
              <div className="search-categories">
                <h3>Recherche par catégorie</h3>
                <div className="category-grid">
                  <div className="category-card">
                    <FaBook className="category-icon" />
                    <h4>Livres Physiques</h4>
                    <p>Ouvrages disponibles en bibliothèque</p>
                  </div>
                  <div className="category-card">
                    <FaFileAlt className="category-icon" />
                    <h4>E-books</h4>
                    <p>Livres numériques à télécharger</p>
                  </div>
                  <div className="category-card">
                    <FaGraduationCap className="category-icon" />
                    <h4>Thèses & Mémoires</h4>
                    <p>Travaux de recherche académique</p>
                  </div>
                  <div className="category-card">
                    <FaNewspaper className="category-icon" />
                    <h4>Périodiques</h4>
                    <p>Revues et magazines spécialisés</p>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* Section Paniers */}
          {activeTab === 'carts' && (
            <div className="carts-compact-content">
              <div className="carts-header-compact">
                <div className="header-info-compact">
                  <h2>Mes Paniers</h2>
                  <p className="carts-summary-compact">
                    {loanCart.length + reservationCart.length + shopCart.length} articles au total
                  </p>
                </div>
                <div className="header-actions-compact">
                  <button className="btn-clear-all-compact">
                    <FaTrash />
                    Tout vider
                  </button>
                </div>
              </div>

              {/* Statistiques des paniers */}
              <div className="carts-quick-stats">
                <div className="quick-cart-stat loan">
                  <FaBook className="cart-icon" />
                  <div className="stat-info">
                    <span className="stat-number">{loanCart.length}</span>
                    <span className="stat-label">Emprunts</span>
                  </div>
                </div>
                <div className="quick-cart-stat reservation">
                  <FaBookmark className="cart-icon" />
                  <div className="stat-info">
                    <span className="stat-number">{reservationCart.length}</span>
                    <span className="stat-label">Réservations</span>
                  </div>
                </div>
                <div className="quick-cart-stat shop">
                  <FaStore className="cart-icon" />
                  <div className="stat-info">
                    <span className="stat-number">{shopCart.length}</span>
                    <span className="stat-label">Boutique</span>
                  </div>
                </div>
              </div>

              <div className="carts-grid-compact">
                {/* Panier Emprunts Compact */}
                <div className="cart-compact loan">
                  <div className="cart-header-compact">
                    <div className="cart-title-compact">
                      <FaBook className="cart-header-icon" />
                      <h3>Emprunts</h3>
                      <span className="cart-badge">{loanCart.length}</span>
                    </div>
                    {loanCart.length > 0 && (
                      <button className="cart-action-btn">
                        <FaCheckCircle />
                        Confirmer
                      </button>
                    )}
                  </div>
                  <div className="cart-content-compact">
                    {loanCart.length > 0 ? (
                      <>
                        {loanCart.slice(0, 3).map((item, index) => (
                          <div key={index} className="cart-item-compact">
                            <div className="item-icon">
                              <FaBook />
                            </div>
                            <div className="item-details">
                              <h5>{item.title}</h5>
                              <p>par {item.author}</p>
                            </div>
                            <button className="item-remove-btn">
                              <FaTimes />
                            </button>
                          </div>
                        ))}
                        {loanCart.length > 3 && (
                          <div className="cart-more-items">
                            <span>+{loanCart.length - 3} autres articles</span>
                          </div>
                        )}
                      </>
                    ) : (
                      <div className="cart-empty-compact">
                        <FaBook className="empty-icon" />
                        <p>Panier vide</p>
                        <span>Ajoutez des livres à emprunter</span>
                      </div>
                    )}
                  </div>
                </div>

                {/* Panier Réservations Compact */}
                <div className="cart-compact reservation">
                  <div className="cart-header-compact">
                    <div className="cart-title-compact">
                      <FaBookmark className="cart-header-icon" />
                      <h3>Réservations</h3>
                      <span className="cart-badge">{reservationCart.length}</span>
                    </div>
                    {reservationCart.length > 0 && (
                      <button className="cart-action-btn">
                        <FaCheckCircle />
                        Réserver
                      </button>
                    )}
                  </div>
                  <div className="cart-content-compact">
                    {reservationCart.length > 0 ? (
                      <>
                        {reservationCart.slice(0, 3).map((item, index) => (
                          <div key={index} className="cart-item-compact">
                            <div className="item-icon">
                              <FaBookmark />
                            </div>
                            <div className="item-details">
                              <h5>{item.title}</h5>
                              <p>par {item.author}</p>
                            </div>
                            <button className="item-remove-btn">
                              <FaTimes />
                            </button>
                          </div>
                        ))}
                        {reservationCart.length > 3 && (
                          <div className="cart-more-items">
                            <span>+{reservationCart.length - 3} autres articles</span>
                          </div>
                        )}
                      </>
                    ) : (
                      <div className="cart-empty-compact">
                        <FaBookmark className="empty-icon" />
                        <p>Panier vide</p>
                        <span>Réservez des livres indisponibles</span>
                      </div>
                    )}
                  </div>
                </div>

                {/* Panier Boutique Compact */}
                <div className="cart-compact shop">
                  <div className="cart-header-compact">
                    <div className="cart-title-compact">
                      <FaStore className="cart-header-icon" />
                      <h3>Boutique</h3>
                      <span className="cart-badge">{shopCart.length}</span>
                    </div>
                    {shopCart.length > 0 && (
                      <button className="cart-action-btn">
                        <FaShoppingCart />
                        Commander
                      </button>
                    )}
                  </div>
                  <div className="cart-content-compact">
                    {shopCart.length > 0 ? (
                      <>
                        {shopCart.slice(0, 3).map((item, index) => (
                          <div key={index} className="cart-item-compact shop-item">
                            <div className="item-icon">
                              <FaStore />
                            </div>
                            <div className="item-details">
                              <h5>{item.title}</h5>
                              <p className="item-price">{item.price?.toLocaleString()} FCFA</p>
                            </div>
                            <button className="item-remove-btn">
                              <FaTimes />
                            </button>
                          </div>
                        ))}
                        {shopCart.length > 3 && (
                          <div className="cart-more-items">
                            <span>+{shopCart.length - 3} autres articles</span>
                            <div className="cart-total">
                              <strong>Total: {shopCart.reduce((total, item) => total + (item.price || 0), 0).toLocaleString()} FCFA</strong>
                            </div>
                          </div>
                        )}
                        {shopCart.length <= 3 && shopCart.length > 0 && (
                          <div className="cart-total">
                            <strong>Total: {shopCart.reduce((total, item) => total + (item.price || 0), 0).toLocaleString()} FCFA</strong>
                          </div>
                        )}
                      </>
                    ) : (
                      <div className="cart-empty-compact">
                        <FaStore className="empty-icon" />
                        <p>Panier vide</p>
                        <span>Achetez des livres et formations</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* Section Boutique */}
          {activeTab === 'shop' && (
            <div className="section-flat-content">
              {/* En-tête boutique améliorée */}
              <div className="shop-header-enhanced">
                <div className="shop-hero">
                  <div className="shop-hero-content">
                    <h2>🛍️ Boutique ZTF</h2>
                    <p className="shop-subtitle">Découvrez notre sélection de livres, formations et ressources théologiques</p>
                    <div className="shop-stats">
                      <div className="shop-stat">
                        <FaBook className="shop-stat-icon" />
                        <span>{shopItems.filter(item => item.category === 'book').length} Livres</span>
                      </div>
                      <div className="shop-stat">
                        <FaGraduationCap className="shop-stat-icon" />
                        <span>{shopItems.filter(item => item.category === 'course').length} Formations</span>
                      </div>
                      <div className="shop-stat">
                        <FaFileAlt className="shop-stat-icon" />
                        <span>{shopItems.filter(item => item.category === 'bundle').length} Collections</span>
                      </div>
                    </div>
                  </div>
                  <div className="shop-hero-badge">
                    <div className="badge-content">
                      <FaAward className="badge-icon" />
                      <span>Qualité garantie</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Filtres et catégories */}
              <div className="shop-filters-section">
                <div className="shop-categories-enhanced">
                  <button className="shop-category-btn-enhanced active">
                    <span className="category-icon">📚</span>
                    <span>Tous ({shopItems.length})</span>
                  </button>
                  <button className="shop-category-btn-enhanced">
                    <span className="category-icon">📖</span>
                    <span>Livres ({shopItems.filter(item => item.category === 'book').length})</span>
                  </button>
                  <button className="shop-category-btn-enhanced">
                    <span className="category-icon">🎓</span>
                    <span>Formations ({shopItems.filter(item => item.category === 'course').length})</span>
                  </button>
                  <button className="shop-category-btn-enhanced">
                    <span className="category-icon">📦</span>
                    <span>Collections ({shopItems.filter(item => item.category === 'bundle').length})</span>
                  </button>
                </div>
                
                <div className="shop-sort">
                  <select className="shop-sort-select">
                    <option>Trier par popularité</option>
                    <option>Prix croissant</option>
                    <option>Prix décroissant</option>
                    <option>Nouveautés</option>
                    <option>Meilleures notes</option>
                  </select>
                </div>
              </div>

              {/* Grille des produits améliorée */}
              <div className="shop-items-grid-enhanced">
                {shopItems.map(item => (
                  <div key={item.id} className="shop-item-card-enhanced">
                    {/* Badges spéciaux */}
                    <div className="item-badges">
                      {item.bestseller && <span className="badge badge-bestseller">🔥 Bestseller</span>}
                      {item.newRelease && <span className="badge badge-new">✨ Nouveau</span>}
                      {item.popular && <span className="badge badge-popular">⭐ Populaire</span>}
                      {item.studentDiscount && <span className="badge badge-student">🎓 -25%</span>}
                    </div>
                    
                    {/* En-tête avec type et prix */}
                    <div className="shop-item-header-enhanced">
                      <div className="item-type-badge">
                        {item.type === 'digital' ? (
                          <span className="type-digital">📱 Digital</span>
                        ) : item.type === 'bundle' ? (
                          <span className="type-bundle">📦 Pack</span>
                        ) : (
                          <span className="type-physical">📚 Physique</span>
                        )}
                      </div>
                      
                      <div className="item-pricing">
                        {item.originalPrice && (
                          <span className="original-price">{item.originalPrice.toLocaleString()} FCFA</span>
                        )}
                        <span className="current-price">{item.price.toLocaleString()} FCFA</span>
                      </div>
                    </div>
                    
                    {/* Contenu principal */}
                    <div className="shop-item-content-enhanced">
                      <h4 className="item-title">{item.title}</h4>
                      <p className="item-author">par {item.author}</p>
                      <p className="item-description">{item.description}</p>
                      
                      {/* Informations spécifiques */}
                      <div className="item-details">
                        {item.duration && (
                          <div className="detail-item">
                            <FaClock className="detail-icon" />
                            <span>{item.duration}</span>
                          </div>
                        )}
                        {item.stock && (
                          <div className="detail-item">
                            <FaBoxes className="detail-icon" />
                            <span>{item.stock} en stock</span>
                          </div>
                        )}
                        {item.items && (
                          <div className="detail-item">
                            <FaFileAlt className="detail-icon" />
                            <span>{item.items}</span>
                          </div>
                        )}
                      </div>
                      
                      {/* Note */}
                      {item.rating && (
                        <div className="item-rating">
                          <div className="stars">
                            {[...Array(5)].map((_, i) => (
                              <FaStar 
                                key={i} 
                                className={i < Math.floor(item.rating) ? 'star-filled' : 'star-empty'} 
                              />
                            ))}
                          </div>
                          <span className="rating-value">({item.rating})</span>
                        </div>
                      )}
                    </div>
                    
                    {/* Actions */}
                    <div className="shop-item-actions-enhanced">
                      <button 
                        className="btn-add-cart"
                        onClick={() => addToCart(item, 'shop')}
                      >
                        <FaShoppingCart />
                        Ajouter au panier
                      </button>
                      <div className="secondary-actions">
                        <button className="btn-icon" title="Voir détails">
                          <FaEye />
                        </button>
                        <button className="btn-icon" title="Ajouter aux favoris">
                          <FaHeart />
                        </button>
                        <button className="btn-icon" title="Partager">
                          <FaShare />
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              
              {/* Bannière promotionnelle */}
              <div className="shop-promo-banner">
                <div className="promo-content">
                  <h3>🎓 Offre Étudiants</h3>
                  <p>-25% sur tous les packs étudiants avec votre carte d'étudiant ZTF</p>
                  <button className="btn-promo">Voir les offres étudiants</button>
                </div>
              </div>
            </div>
          )}

          {/* Section Emprunts & Historique */}
          {activeTab === 'loans' && (
            <div className="loans-merged-content">
              <div className="loans-header-compact">
                <div className="header-info-compact">
                  <h2>Emprunts & Historique</h2>
                  <p className="loans-stats-compact">
                    {accountStats.currentLoans} actifs • {accountStats.totalLoans} au total • {loanHistory.length} évalués
                  </p>
                </div>
                <div className="header-actions-compact">
                  <button className="btn-export-compact">
                    <FaDownload />
                    Exporter
                  </button>
                </div>
              </div>

              {/* Statistiques rapides */}
              <div className="loans-quick-stats">
                <div className="quick-stat-item">
                  <FaBook className="quick-stat-icon active" />
                  <div className="quick-stat-info">
                    <span className="quick-stat-number">{accountStats.currentLoans}</span>
                    <span className="quick-stat-label">En cours</span>
                  </div>
                </div>
                <div className="quick-stat-item">
                  <FaExclamationTriangle className="quick-stat-icon warning" />
                  <div className="quick-stat-info">
                    <span className="quick-stat-number">{accountStats.overdue}</span>
                    <span className="quick-stat-label">En retard</span>
                  </div>
                </div>
                <div className="quick-stat-item">
                  <FaStar className="quick-stat-icon success" />
                  <div className="quick-stat-info">
                    <span className="quick-stat-number">4.2</span>
                    <span className="quick-stat-label">Note moy.</span>
                  </div>
                </div>
                <div className="quick-stat-item">
                  <FaPercent className="quick-stat-icon info" />
                  <div className="quick-stat-info">
                    <span className="quick-stat-number">95%</span>
                    <span className="quick-stat-label">À temps</span>
                  </div>
                </div>
              </div>

              {/* Navigation sous-onglets */}
              <div className="loans-subtabs">
                <button 
                  className={`subtab-btn ${activeLoansTab === 'current' ? 'active' : ''}`}
                  onClick={() => setActiveLoansTab('current')}
                >
                  <FaBook />
                  Emprunts actuels ({accountStats.currentLoans})
                </button>
                <button 
                  className={`subtab-btn ${activeLoansTab === 'history' ? 'active' : ''}`}
                  onClick={() => setActiveLoansTab('history')}
                >
                  <FaHistory />
                  Historique ({accountStats.totalLoans})
                </button>
              </div>

              {/* Contenu selon l'onglet actif */}
              {activeLoansTab === 'current' && (
                <div className="current-loans-section">
                  <div className="section-filters-compact">
                    <select className="filter-select-compact">
                      <option>Tous les types</option>
                      <option>Livres physiques</option>
                      <option>E-books</option>
                    </select>
                    <select className="filter-select-compact">
                      <option>Tous les statuts</option>
                      <option>À jour</option>
                      <option>Bientôt dû</option>
                      <option>En retard</option>
                    </select>
                  </div>

                  <div className="loans-grid-compact">
                    {currentLoans.map(loan => {
                      const dueStatus = getDueDateStatus(loan.dueDate);
                      return (
                        <div key={loan.id} className="loan-card-compact">
                          <div className="loan-header-compact">
                            <div className="loan-type-icon">
                              {loan.type === 'ebook' ? <FaFileAlt /> : <FaBook />}
                            </div>
                            <div className="loan-title-compact">
                              <h4>{loan.title}</h4>
                              <p>par {loan.author}</p>
                            </div>
                            <div className={`status-indicator ${dueStatus.class}`}>
                              <span>{dueStatus.text}</span>
                            </div>
                          </div>
                          
                          <div className="loan-details-compact">
                            <div className="detail-row">
                              <FaCalendar className="detail-icon" />
                              <span>Emprunté le {new Date(loan.loanDate).toLocaleDateString('fr-FR')}</span>
                            </div>
                            <div className="detail-row">
                              <FaClock className="detail-icon" />
                              <span>À retourner le {new Date(loan.dueDate).toLocaleDateString('fr-FR')}</span>
                            </div>
                            <div className="detail-row">
                              <FaMapMarkerAlt className="detail-icon" />
                              <span>{loan.location}</span>
                            </div>
                          </div>

                          <div className="loan-actions-compact">
                            <button className="action-btn-compact primary">
                              <FaRedo />
                              Renouveler
                            </button>
                            <button className="action-btn-compact secondary">
                              <FaEye />
                              Détails
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {activeLoansTab === 'history' && (
                <div className="history-section">
                  <div className="section-filters-compact">
                    <select className="filter-select-compact">
                      <option>Toutes les années</option>
                      <option>2024</option>
                      <option>2023</option>
                      <option>2022</option>
                    </select>
                    <select className="filter-select-compact">
                      <option>Tous les types</option>
                      <option>Livres physiques</option>
                      <option>E-books</option>
                      <option>Thèses</option>
                    </select>
                    <select className="filter-select-compact">
                      <option>Toutes les notes</option>
                      <option>5 étoiles</option>
                      <option>4+ étoiles</option>
                      <option>3+ étoiles</option>
                    </select>
                  </div>

                  <div className="history-timeline-compact">
                    <div className="timeline-period-header">
                      <h3>2024</h3>
                      <span className="period-count">24 emprunts</span>
                    </div>
                    
                    {loanHistory.map((item, index) => (
                      <div key={item.id} className="timeline-item-compact">
                        <div className="timeline-date-compact">
                          <div className="date-month">
                            {new Date(item.returnDate).toLocaleDateString('fr-FR', { month: 'short' })}
                          </div>
                          <div className="date-day">
                            {new Date(item.returnDate).getDate()}
                          </div>
                        </div>
                        
                        <div className="timeline-connector-compact">
                          <div className="connector-line-compact"></div>
                          <div className="connector-dot-compact completed">
                            <FaCheckCircle />
                          </div>
                        </div>
                        
                        <div className="timeline-content-compact">
                          <div className="content-header-compact">
                            <div className="document-info-compact">
                              <h4>{item.title}</h4>
                              <p>par {item.author}</p>
                            </div>
                            <div className="rating-compact">
                              <div className="stars-compact">
                                {[...Array(5)].map((_, i) => (
                                  <FaStar 
                                    key={i} 
                                    className={i < item.rating ? 'star-filled' : 'star-empty'} 
                                  />
                                ))}
                              </div>
                              <span className="rating-value-compact">{item.rating}/5</span>
                            </div>
                          </div>
                          
                          <div className="loan-period-compact">
                            <span className="period-info-compact">
                              {new Date(item.loanDate).toLocaleDateString('fr-FR')} → {new Date(item.returnDate).toLocaleDateString('fr-FR')}
                              ({Math.ceil((new Date(item.returnDate) - new Date(item.loanDate)) / (1000 * 60 * 60 * 24))} jours)
                            </span>
                          </div>
                          
                          <div className="content-actions-compact">
                            <button className="action-btn-compact-small">
                              <FaEye />
                            </button>
                            <button className="action-btn-compact-small">
                              <FaBookmark />
                            </button>
                            <button className="action-btn-compact-small">
                              <FaStar />
                            </button>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* Pagination compacte */}
                  <div className="pagination-compact">
                    <button className="page-btn-compact">
                      <FaChevronLeft />
                    </button>
                    <span className="page-info-compact">1 / 5</span>
                    <button className="page-btn-compact">
                      <FaChevronRight />
                    </button>
                  </div>
                </div>
              )}
            </div>
          )}

          {/* Section Favoris */}
          {activeTab === 'favorites' && (
            <div className="favorites-content">
              <div className="favorites-header">
                <div className="header-info">
                  <h2>Mes Favoris</h2>
                  <p className="favorites-count">{favorites.length} livre(s) dans vos favoris</p>
                </div>
                <div className="favorites-actions">
                  <div className="sort-options">
                    <select className="form-select">
                      <option>Plus récents</option>
                      <option>Alphabétique</option>
                      <option>Par catégorie</option>
                      <option>Mieux notés</option>
                    </select>
                  </div>
                  <div className="view-options">
                    <button className="view-btn active" title="Vue grille">
                      <FaThumbsUp />
                    </button>
                    <button className="view-btn" title="Vue liste">
                      <FaList />
                    </button>
                  </div>
                </div>
              </div>

              <div className="favorites-grid">
                {favorites.map(favorite => (
                  <div key={favorite.id} className="favorite-card">
                    <div className="favorite-image">
                      <img src={favorite.cover} alt={favorite.title} />
                      <div className="image-overlay">
                        <div className="availability-badge">
                          {favorite.available ? (
                            <span className="available">
                              <FaCheckCircle />
                              Disponible
                            </span>
                          ) : (
                            <span className="unavailable">
                              <FaClock />
                              Indisponible
                            </span>
                          )}
                        </div>
                        <button className="remove-favorite" onClick={() => {
                          setFavorites(favorites.filter(f => f.id !== favorite.id));
                        }}>
                          <FaHeart />
                        </button>
                      </div>
                    </div>
                    
                    <div className="favorite-content">
                      <div className="category-tag">
                        {favorite.category}
                      </div>
                      <h4 className="favorite-title">{favorite.title}</h4>
                      <p className="favorite-author">par {favorite.author}</p>
                      
                      <div className="favorite-rating">
                        <div className="stars">
                          {[...Array(5)].map((_, i) => (
                            <FaStar 
                              key={i} 
                              className={i < Math.floor(favorite.rating) ? 'star-filled' : 'star-empty'} 
                            />
                          ))}
                        </div>
                        <span className="rating-value">{favorite.rating}</span>
                      </div>
                      
                      <p className="favorite-description">{favorite.description}</p>
                      
                      <div className="favorite-meta">
                        <span className="isbn">{favorite.isbn}</span>
                        <span className="added-date">
                          Ajouté le {new Date(favorite.addedDate).toLocaleDateString('fr-FR')}
                        </span>
                      </div>
                    </div>
                    
                    <div className="favorite-actions">
                      <button className="btn btn-primary" disabled={!favorite.available}>
                        <FaBook />
                        {favorite.available ? 'Emprunter' : 'Réserver'}
                      </button>
                      <button className="btn btn-outline-secondary">
                        <FaEye />
                        Détails
                      </button>
                      <button className="btn btn-outline-info">
                        <FaShare />
                        Partager
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              {favorites.length === 0 && (
                <div className="empty-favorites">
                  <div className="empty-icon">
                    <FaRegHeart />
                  </div>
                  <h3>Aucun favori</h3>
                  <p>Commencez à ajouter des livres à vos favoris pour les retrouver facilement.</p>
                  <button className="btn btn-primary">
                    <FaSearch />
                    Explorer le catalogue
                  </button>
                </div>
              )}
            </div>
          )}

          {/* Section Mon Compte */}
          {activeTab === 'account' && (
            <div className="account-content">
              {/* Profile Cover & Avatar - Style Bibliothèque */}
              <div className="profile-header-library">
                <div className="library-cover">
                  {/* Image de fond bibliothèque */}
                  <div className="library-background">
                    <div className="library-pattern">
                      <div className="bookshelf-pattern">
                        {[...Array(20)].map((_, i) => (
                          <div key={i} className={`book book-${(i % 5) + 1}`}></div>
                        ))}
                      </div>
                      <div className="library-icons">
                        <FaBook className="floating-icon icon-1" />
                        <FaGraduationCap className="floating-icon icon-2" />
                        <FaFileAlt className="floating-icon icon-3" />
                        <FaBookmark className="floating-icon icon-4" />
                      </div>
                    </div>
                  </div>
                  
                  {/* Superposition avec informations utilisateur */}
                  <div className="profile-overlay">
                    <div className="profile-content">
                      <div className="profile-avatar-library">
                        <div className="avatar-ring">
                          <FaUser size={50} />
                        </div>
                        <div className="status-indicator online"></div>
                      </div>
                      
                      <div className="profile-info-library">
                        <h1 className="profile-name">{userInfo.firstName} {userInfo.lastName}</h1>
                        <p className="profile-title">📚 Membre de la Bibliothèque ZTF</p>
                        <div className="profile-stats-quick">
                          <div className="quick-stat">
                            <FaBook />
                            <span>{accountStats.totalLoans} emprunts</span>
                          </div>
                          <div className="quick-stat">
                            <FaCalendar />
                            <span>Depuis {new Date(userInfo.joinDate).getFullYear()}</span>
                          </div>
                          <div className="quick-stat">
                            <FaAward />
                            <span>{getUserTypeLabel(userInfo.userType)}</span>
                          </div>
                        </div>
                        
                        <div className="profile-badges-library">
                          <span className="badge-library verified">
                            <FaCheckCircle /> Compte vérifié
                          </span>
                          <span className="badge-library active">
                            <FaCircle /> Actif
                          </span>
                        </div>
                      </div>
                    </div>
                    
                    {/* Bouton d'action */}
                    <div className="profile-actions">
                      <button className="btn-edit-profile">
                        <FaEdit /> Modifier le profil
                      </button>
                    </div>
                  </div>
                </div>
                
                {/* Barre d'informations rapides */}
                <div className="library-info-bar">
                  <div className="info-item">
                    <div className="info-icon">📍</div>
                    <div className="info-content">
                      <span className="info-label">Localisation</span>
                      <span className="info-value">{userInfo.address}</span>
                    </div>
                  </div>
                  <div className="info-item">
                    <div className="info-icon">🎓</div>
                    <div className="info-content">
                      <span className="info-label">Département</span>
                      <span className="info-value">{userInfo.department}</span>
                    </div>
                  </div>
                  <div className="info-item">
                    <div className="info-icon">📧</div>
                    <div className="info-content">
                      <span className="info-label">Contact</span>
                      <span className="info-value">{userInfo.email}</span>
                    </div>
                  </div>
                  <div className="info-item">
                    <div className="info-icon">⏰</div>
                    <div className="info-content">
                      <span className="info-label">Dernière activité</span>
                      <span className="info-value">Il y a 2 heures</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Stats Cards - Style Réseau Social */}
              <div className="social-stats-grid">
                <div className="social-stat-card">
                  <FaBook className="stat-icon-social" />
                  <div className="stat-content-social">
                    <h3>{accountStats.totalLoans}</h3>
                    <p>Emprunts Total</p>
                  </div>
                </div>
                <div className="social-stat-card">
                  <FaHeart className="stat-icon-social" />
                  <div className="stat-content-social">
                    <h3>{favorites.length}</h3>
                    <p>Favoris</p>
                  </div>
                </div>
                <div className="social-stat-card">
                  <FaClock className="stat-icon-social" />
                  <div className="stat-content-social">
                    <h3>{accountStats.currentLoans}</h3>
                    <p>Actifs</p>
                  </div>
                </div>
                <div className="social-stat-card">
                  <FaCalendar className="stat-icon-social" />
                  <div className="stat-content-social">
                    <h3>{Math.floor((Date.now() - new Date(userInfo.joinDate)) / (1000 * 60 * 60 * 24))}</h3>
                    <p>Jours</p>
                  </div>
                </div>
              </div>

              {/* Info Cards - Style Réseau Social */}
              <div className="social-info-grid">
                <div className="social-info-card">
                  <div className="info-header-social">
                    <h3><FaUser size={18} /> À propos</h3>
                  </div>
                  <div className="social-info-list">
                    <div className="info-item-social">
                      <FaEnvelope className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Email</span>
                        <span className="info-value-social">{userInfo.email}</span>
                      </div>
                    </div>
                    <div className="info-item-social">
                      <FaPhone className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Téléphone</span>
                        <span className="info-value-social">{userInfo.phone}</span>
                      </div>
                    </div>
                    <div className="info-item-social">
                      <FaMapMarkerAlt className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Localisation</span>
                        <span className="info-value-social">{userInfo.address}</span>
                      </div>
                    </div>
                    <div className="info-item-social">
                      <FaGraduationCap className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Département</span>
                        <span className="info-value-social">{userInfo.department}</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="social-info-card">
                  <div className="info-header-social">
                    <h3><FaShieldAlt size={18} /> Activité Récente</h3>
                  </div>
                  <div className="social-info-list">
                    <div className="info-item-social">
                      <FaBook className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Dernier emprunt</span>
                        <span className="info-value-social">Il y a 2 heures</span>
                      </div>
                    </div>
                    <div className="info-item-social">
                      <FaHeart className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Ajout aux favoris</span>
                        <span className="info-value-social">Il y a 1 jour</span>
                      </div>
                    </div>
                    <div className="info-item-social">
                      <FaCheckCircle className="info-icon-social" />
                      <div className="info-content-social">
                        <span className="info-label-social">Livre rendu</span>
                        <span className="info-value-social">Il y a 3 jours</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div className="row g-4">
                <div className="col-lg-8">
                  <div className="section-card">
                    <div className="section-header">
                      <h3>Informations personnelles</h3>
                      <button 
                        className="btn btn-outline-primary btn-sm"
                        onClick={() => setIsEditing(!isEditing)}
                      >
                        <FaEdit />
                        {isEditing ? 'Annuler' : 'Modifier'}
                      </button>
                    </div>
                    <div className="section-content">
                      <div className="form-grid">
                        <div className="form-group">
                          <label>Prénom</label>
                          {isEditing ? (
                            <input type="text" className="form-control" value={userInfo.firstName} />
                          ) : (
                            <div className="form-display">{userInfo.firstName}</div>
                          )}
                        </div>
                        <div className="form-group">
                          <label>Nom</label>
                          {isEditing ? (
                            <input type="text" className="form-control" value={userInfo.lastName} />
                          ) : (
                            <div className="form-display">{userInfo.lastName}</div>
                          )}
                        </div>
                        <div className="form-group">
                          <label>Email</label>
                          {isEditing ? (
                            <input type="email" className="form-control" value={userInfo.email} />
                          ) : (
                            <div className="form-display">
                              <FaEnvelope size={14} />
                              {userInfo.email}
                            </div>
                          )}
                        </div>
                        <div className="form-group">
                          <label>Téléphone</label>
                          {isEditing ? (
                            <input type="tel" className="form-control" value={userInfo.phone} />
                          ) : (
                            <div className="form-display">
                              <FaPhone size={14} />
                              {userInfo.phone}
                            </div>
                          )}
                        </div>
                        <div className="form-group">
                          <label>Département</label>
                          {isEditing ? (
                            <input type="text" className="form-control" value={userInfo.department} />
                          ) : (
                            <div className="form-display">
                              <FaGraduationCap size={14} />
                              {userInfo.department}
                            </div>
                          )}
                        </div>
                        <div className="form-group col-span-2">
                          <label>Adresse</label>
                          {isEditing ? (
                            <input type="text" className="form-control" value={userInfo.address} />
                          ) : (
                            <div className="form-display">
                              <FaMapMarkerAlt size={14} />
                              {userInfo.address}
                            </div>
                          )}
                        </div>
                      </div>
                      {isEditing && (
                        <div className="form-actions">
                          <button className="btn btn-success">
                            <FaCheck />
                            Sauvegarder
                          </button>
                          <button className="btn btn-outline-secondary" onClick={() => setIsEditing(false)}>
                            <FaTimes />
                            Annuler
                          </button>
                        </div>
                      )}
                    </div>
                  </div>

                  <div className="section-card">
                    <div className="section-header">
                      <h3>Sécurité du compte</h3>
                    </div>
                    <div className="section-content">
                      <div className="security-items">
                        <div className="security-item">
                          <div className="security-info">
                            <FaKey className="security-icon" />
                            <div>
                              <h5>Mot de passe</h5>
                              <p>Dernière modification : il y a 3 mois</p>
                            </div>
                          </div>
                          <button className="btn btn-outline-warning">
                            Modifier
                          </button>
                        </div>
                        <div className="security-item">
                          <div className="security-info">
                            <FaShieldAlt className="security-icon" />
                            <div>
                              <h5>Authentification à deux facteurs</h5>
                              <p>Renforcez la sécurité de votre compte</p>
                            </div>
                          </div>
                          <button className="btn btn-outline-success">
                            Activer
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="col-lg-4">
                  <div className="section-card">
                    <div className="section-header">
                      <h3>Résumé du compte</h3>
                    </div>
                    <div className="section-content">
                      <div className="account-summary">
                        <div className="summary-item">
                          <div className="summary-icon books">
                            <FaBook />
                          </div>
                          <div className="summary-info">
                            <h4>{accountStats.totalLoans}</h4>
                            <p>Emprunts totaux</p>
                          </div>
                        </div>
                        <div className="summary-item">
                          <div className="summary-icon favorites">
                            <FaHeart />
                          </div>
                          <div className="summary-info">
                            <h4>{favorites.length}</h4>
                            <p>Favoris</p>
                          </div>
                        </div>
                        <div className="summary-item">
                          <div className="summary-icon downloads">
                            <FaDownload />
                          </div>
                          <div className="summary-info">
                            <h4>{accountStats.downloads}</h4>
                            <p>Téléchargements</p>
                          </div>
                        </div>
                        <div className="summary-item">
                          <div className="summary-icon membership">
                            <FaCalendar />
                          </div>
                          <div className="summary-info">
                            <h4>{new Date().getFullYear() - new Date(userInfo.joinDate).getFullYear()}</h4>
                            <p>Années d'adhésion</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="section-card">
                    <div className="section-header">
                      <h3>Actions rapides</h3>
                    </div>
                    <div className="section-content">
                      <div className="quick-actions">
                        <button className="quick-action-btn">
                          <FaPrint />
                          Imprimer le profil
                        </button>
                        <button className="quick-action-btn">
                          <FaDownload />
                          Exporter les données
                        </button>
                        <button className="quick-action-btn">
                          <FaSync />
                          Synchroniser
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* Section Paramètres */}
          {activeTab === 'settings' && (
            <div className="settings-redesigned">
              {/* En-tête des paramètres */}
              <div className="settings-header-redesigned">
                <div className="settings-title-section">
                  <h2>Paramètres</h2>
                  <p className="settings-subtitle">Personnalisez votre expérience bibliothèque</p>
                </div>
                <div className="settings-actions">
                  <button className="settings-save-btn">
                    <FaCheck />
                    Sauvegarder
                  </button>
                </div>
              </div>

              {/* Navigation des sections */}
              <div className="settings-nav">
                <div className="settings-nav-item active">
                  <FaBell className="nav-icon" />
                  <span>Notifications</span>
                </div>
                <div className="settings-nav-item">
                  <FaShieldAlt className="nav-icon" />
                  <span>Confidentialité</span>
                </div>
                <div className="settings-nav-item">
                  <FaPalette className="nav-icon" />
                  <span>Apparence</span>
                </div>
                <div className="settings-nav-item">
                  <FaBook className="nav-icon" />
                  <span>Lecture</span>
                </div>
                <div className="settings-nav-item">
                  <FaCog className="nav-icon" />
                  <span>Avancé</span>
                </div>
              </div>

              {/* Contenu des paramètres */}
              <div className="settings-content-redesigned">
                
                {/* Section Notifications */}
                <div className="settings-section-redesigned">
                  <div className="section-header-redesigned">
                    <div className="section-title-redesigned">
                      <FaBell className="section-icon-redesigned" />
                      <div className="title-info">
                        <h3>Notifications</h3>
                        <p>Gérez vos alertes et rappels</p>
                      </div>
                    </div>
                  </div>

                  <div className="settings-cards-grid">
                    <div className="setting-card">
                      <div className="card-header">
                        <FaEnvelope className="card-icon" />
                        <div className="card-title">
                          <h4>Notifications par email</h4>
                          <p>Recevez les alertes importantes par email</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="email-notifications"
                            checked={preferences.notifications.email}
                          />
                          <label htmlFor="email-notifications"></label>
                        </div>
                      </div>
                    </div>

                    <div className="setting-card">
                      <div className="card-header">
                        <FaPhone className="card-icon" />
                        <div className="card-title">
                          <h4>Notifications SMS</h4>
                          <p>Alertes urgentes par SMS</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="sms-notifications"
                            checked={preferences.notifications.sms}
                          />
                          <label htmlFor="sms-notifications"></label>
                        </div>
                      </div>
                    </div>

                    <div className="setting-card">
                      <div className="card-header">
                        <FaBook className="card-icon" />
                        <div className="card-title">
                          <h4>Nouvelles acquisitions</h4>
                          <p>Soyez informé des nouveaux livres</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="new-books"
                            checked={preferences.notifications.newBooks}
                          />
                          <label htmlFor="new-books"></label>
                        </div>
                      </div>
                    </div>

                    <div className="setting-card">
                      <div className="card-header">
                        <FaClock className="card-icon" />
                        <div className="card-title">
                          <h4>Rappels d'échéance</h4>
                          <p>Alertes avant les dates de retour</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="due-dates"
                            checked={preferences.notifications.dueDates}
                          />
                          <label htmlFor="due-dates"></label>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Section Confidentialité */}
                <div className="settings-section-redesigned">
                  <div className="section-header-redesigned">
                    <div className="section-title-redesigned">
                      <FaShieldAlt className="section-icon-redesigned" />
                      <div className="title-info">
                        <h3>Confidentialité</h3>
                        <p>Contrôlez la visibilité de vos données</p>
                      </div>
                    </div>
                  </div>

                  <div className="settings-cards-grid">
                    <div className="setting-card">
                      <div className="card-header">
                        <FaEye className="card-icon" />
                        <div className="card-title">
                          <h4>Profil public</h4>
                          <p>Rendez votre profil visible aux autres</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="public-profile"
                            checked={preferences.privacy.profileVisibility === 'public'}
                          />
                          <label htmlFor="public-profile"></label>
                        </div>
                      </div>
                    </div>

                    <div className="setting-card">
                      <div className="card-header">
                        <FaHistory className="card-icon" />
                        <div className="card-title">
                          <h4>Historique de lecture</h4>
                          <p>Partagez vos activités de lecture</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="show-activity"
                            checked={preferences.privacy.showActivity}
                          />
                          <label htmlFor="show-activity"></label>
                        </div>
                      </div>
                    </div>

                    <div className="setting-card">
                      <div className="card-header">
                        <FaStar className="card-icon" />
                        <div className="card-title">
                          <h4>Recommandations</h4>
                          <p>Recevez des suggestions personnalisées</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="recommendations"
                            checked={preferences.privacy.allowRecommendations}
                          />
                          <label htmlFor="recommendations"></label>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Section Apparence */}
                <div className="settings-section-redesigned">
                  <div className="section-header-redesigned">
                    <div className="section-title-redesigned">
                      <FaPalette className="section-icon-redesigned" />
                      <div className="title-info">
                        <h3>Apparence</h3>
                        <p>Personnalisez l'interface à votre goût</p>
                      </div>
                    </div>
                  </div>

                  <div className="settings-cards-grid">
                    <div className="setting-card full-width">
                      <div className="card-header">
                        <FaLanguage className="card-icon" />
                        <div className="card-title">
                          <h4>Langue de l'interface</h4>
                          <p>Choisissez votre langue préférée</p>
                        </div>
                        <select className="modern-select" value={preferences.interface.language}>
                          <option value="fr">🇫🇷 Français</option>
                          <option value="en">🇺🇸 English</option>
                        </select>
                      </div>
                    </div>

                    <div className="setting-card full-width">
                      <div className="card-header">
                        <FaPalette className="card-icon" />
                        <div className="card-title">
                          <h4>Thème d'affichage</h4>
                          <p>Sélectionnez votre thème préféré</p>
                        </div>
                        <div className="theme-selector">
                          <div className="theme-option">
                            <input 
                              type="radio" 
                              name="theme" 
                              id="theme-light"
                              value="light"
                              checked={preferences.interface.theme === 'light'}
                            />
                            <label htmlFor="theme-light" className="theme-label light">
                              ☀️ Clair
                            </label>
                          </div>
                          <div className="theme-option">
                            <input 
                              type="radio" 
                              name="theme" 
                              id="theme-dark"
                              value="dark"
                              checked={preferences.interface.theme === 'dark'}
                            />
                            <label htmlFor="theme-dark" className="theme-label dark">
                              🌙 Sombre
                            </label>
                          </div>
                          <div className="theme-option">
                            <input 
                              type="radio" 
                              name="theme" 
                              id="theme-auto"
                              value="auto"
                              checked={preferences.interface.theme === 'auto'}
                            />
                            <label htmlFor="theme-auto" className="theme-label auto">
                              🔄 Automatique
                            </label>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div className="setting-card">
                      <div className="card-header">
                        <FaCompress className="card-icon" />
                        <div className="card-title">
                          <h4>Mode compact</h4>
                          <p>Interface optimisée pour les petits écrans</p>
                        </div>
                        <div className="toggle-switch modern">
                          <input 
                            type="checkbox" 
                            id="compact-mode"
                            checked={preferences.interface.compactMode}
                          />
                          <label htmlFor="compact-mode"></label>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Section Actions */}
                <div className="settings-section-redesigned">
                  <div className="section-header-redesigned">
                    <div className="section-title-redesigned">
                      <FaSync className="section-icon-redesigned" />
                      <div className="title-info">
                        <h3>Actions rapides</h3>
                        <p>Outils de gestion et d'export</p>
                      </div>
                    </div>
                  </div>

                  <div className="quick-actions-redesigned">
                    <button className="action-button-redesigned">
                      <FaDownload className="action-icon" />
                      <div className="action-content">
                        <h4>Exporter mes données</h4>
                        <p>Téléchargez votre historique de lecture</p>
                      </div>
                    </button>

                    <button className="action-button-redesigned">
                      <FaSync className="action-icon" />
                      <div className="action-content">
                        <h4>Synchroniser</h4>
                        <p>Mettre à jour les données depuis le serveur</p>
                      </div>
                    </button>

                    <button className="action-button-redesigned">
                      <FaPrint className="action-icon" />
                      <div className="action-content">
                        <h4>Imprimer le profil</h4>
                        <p>Générer une version imprimable</p>
                      </div>
                    </button>
                  </div>
                </div>

                {/* Section Danger */}
                <div className="settings-section-redesigned danger-section">
                  <div className="section-header-redesigned">
                    <div className="section-title-redesigned">
                      <FaExclamationTriangle className="section-icon-redesigned danger" />
                      <div className="title-info">
                        <h3>Zone de danger</h3>
                        <p>Actions irréversibles - procédez avec prudence</p>
                      </div>
                    </div>
                  </div>

                  <div className="danger-actions-redesigned">
                    <button className="danger-button-redesigned">
                      <FaTrash className="danger-icon" />
                      <div className="danger-content">
                        <h4>Supprimer le compte</h4>
                        <p>Cette action est irréversible</p>
                      </div>
                    </button>
                  </div>
                </div>

              </div>
            </div>
          )}

        </div>
      </main>

      <style jsx>{`
        .library-profile {
          background: #f8f9fa;
